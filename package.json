{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D third-person lantern game (Three.js) with deterministic headless mode",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "headless": "node src/headless/cli.js",
    "test": "node scripts/run-tests.mjs",
    "release": "node scripts/release.mjs",
    "start": "node scripts/play.mjs",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.mjs --seed 7 --nights 10 --out soak.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer": "^23.11.1",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
